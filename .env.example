PORT=5050

# ── Primary writable database (all new tables go here) ────────────────────────
DB_HOST=192.168.10.6
DB_PORT=3306
DB_USER=your_db_user
# IMPORTANT: if your password contains #, =, or spaces, wrap it in double quotes:
#   DB_PASSWORD="p@ss#word"   <- correct
#   DB_PASSWORD=p@ss#word     <- WRONG: # and everything after is treated as a comment
DB_PASSWORD="your_db_password"
DB_NAME=Shivamgiri

# ── Read-only audit databases ─────────────────────────────────────────────────
# WARNING: NEVER run INSERT / UPDATE / DELETE / ALTER / DROP on these databases.
# They are read-only source systems. All write operations must go to DB_NAME only.
DB_AUDIT_NAME=db_audit
DB_EXTERNAL_NAME=db_external

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=8h

# ── AI provider keys (Phase 4) — leave blank to disable ──────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Cron ─────────────────────────────────────────────────────────────────────
# Set to true in development or single-instance non-cron environments
DISABLE_CRON=true
