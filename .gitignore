# ── Environment — never commit real credentials ──────────────────────────────
# Top-level .env files
.env
.env.local
.env.*.local

# Any nested .env at any depth (covers folder/path/.env and any future leaks)
**/.env
**/.env.*
!**/.env.example
!**/example.env

# Build output
dist/
node_modules/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Ad-hoc investigation scripts (may contain credentials)
verify_data*.js
folder/

# Local scratch files
secret-scan-output.txt
*.local.json
.idea/
.vscode/

# Common backup artifacts
*.bak
*.swp
*.tmp